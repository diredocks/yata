<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_vertical">

    <ImageView
        android:id="@+id/widget_container_task_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_item_background" />

    <LinearLayout
        android:id="@+id/widget_container_task_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="42dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_completed_task"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@null"
            android:padding="12dp"
            android:src="@drawable/ic_widget_checkbox_unchecked" />

        <LinearLayout
            android:id="@+id/widget_task_text_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_text_task"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:ellipsize="end"
                android:lines="1"
                android:maxLines="1"
                android:textColor="@color/widget_primary_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/widget_text_task_completed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:ellipsize="end"
                android:lines="1"
                android:maxLines="1"
                android:textColor="@color/widget_secondary_text"
                android:textSize="15sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/widget_task_metadata_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/my_day_indicator_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="3dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_my_day"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/my_day_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_my_day"
                    android:textColor="@color/widget_secondary_text"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/folder_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_secondary_text"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/duedate_indicator_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="3dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_due_date"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/duedate_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_accent"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/duedate_indicator_overdue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_overdue"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/recurrence_indicator"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_repeat"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/reminder_indicator"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="3dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_reminder"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/reminder_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_secondary_text"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_important_task"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null"
            android:padding="12dp"
            android:src="@drawable/ic_widget_star_outline" />
    </LinearLayout>
</FrameLayout>
